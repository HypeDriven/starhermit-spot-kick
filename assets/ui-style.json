    },
    ".section": {
      "border": {
        "width": 1,
        "color": "$edge",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 10,
        "end": 14,
        "bottom": 10,
        "start": 14
      }
    },
    ".ach": {
      "background": "$chip",
      "radius": 8,
      "padding": {
        "top": 6,
        "end": 12,
        "bottom": 6,
        "start": 12

      "background": "$panel",
      "radius": 14,
      "padding": {
        "top": 12,
        "end": 16,
        "bottom": 12,
        "start": 16
      }
    },
    ".tray-sm": {
      "background": "$panel",
      "radius": 12,
      "padding": {
        "top": 6,
        "end": 8,
        "bottom": 6,
        "start": 8
      }
    },

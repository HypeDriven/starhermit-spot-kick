        "size": 14
      }
    },
    ".title-name": {
      "text": {
        "color": "#ffffff",
        "size": 64,
        "weight": "700",
        "letterSpacing": 6,
        "align": "center",
        "shadow": {
          "blur": 22,
          "color": "#5aa0ff66"
        }
      }
    },
    ".title-name-sm": {
      "text": {
        "color": "#ffffff",
        "size": 34,
        "weight": "700",
        "letterSpacing": 6,
        "align": "center",

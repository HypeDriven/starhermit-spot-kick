      "background": "#000000bf",
      "radius": 6,
      "padding": {
        "top": 4,
        "end": 12,
        "bottom": 4,
        "start": 12
      }
    },
    ".toast": {
      "background": "#0c1420f0",
      "radius": 10,
      "shadow": {
        "y": 6,
        "blur": 20,
        "color": "#00000066"
      },
      "padding": {
        "top": 10,
        "end": 16,
        "bottom": 10,
        "start": 16
      }
    },
    ".help-card": {
      "background": "$card",
      "border": {
        "width": {
          "start": 4
